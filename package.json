{
  "name": "synapse-city",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck && npm --prefix packages/simulation run typecheck",
    "test": "npm --prefix packages/simulation test",
    "test:api": "py -3.12 -m pytest services/simulation-api/tests",
    "benchmark": "npm --prefix packages/simulation run benchmark"
  },
  "engines": { "node": ">=22" }
}
